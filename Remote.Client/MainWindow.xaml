<Window x:Class="Remote.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="集控中心 - Remote Desktop" Width="1360" Height="860"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <TextBlock Text="目标 IP（多个用逗号/空格分隔，可写 IP:端口）:"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="HostsBox" Width="330" Text="192.168.1.100"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="口令:" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <PasswordBox x:Name="TokenBox" Width="110" VerticalContentAlignment="Center"/>
            <Button x:Name="ConnectBtn" Content="连接全部" Click="ConnectAll_Click"
                    Margin="8,0,0,0" Padding="12,3"/>
            <Button x:Name="DisconnectBtn" Content="断开全部" Click="DisconnectAll_Click"
                    Margin="8,0,0,0" Padding="12,3" IsEnabled="False"/>
            <Button x:Name="BackBtn" Content="返回网格" Click="Back_Click"
                    Margin="8,0,0,0" Padding="12,3" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Text="未连接" Foreground="#AAAAAA"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="8,0,8,8">
            <UniformGrid x:Name="GridPanel"/>

            <Grid x:Name="DetailPanel" Visibility="Collapsed">
                <Border BorderBrush="#444" BorderThickness="1">
                    <Image x:Name="DetailImage"
                           Focusable="True"
                           Stretch="Uniform"
                           MouseMove="Detail_MouseMove"
                           MouseDown="Detail_MouseButton"
                           MouseUp="Detail_MouseButton"
                           MouseWheel="Detail_MouseWheel"/>
                </Border>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Background="#C0000000" Padding="8,4" Margin="6">
                    <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

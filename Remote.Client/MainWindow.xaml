<Window x:Class="Remote.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程控制 - Remote Desktop" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <TextBlock Text="目标 IP:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="IpBox" Width="160" Text="192.168.1.100" VerticalContentAlignment="Center"/>
            <TextBlock Text="口令:" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <PasswordBox x:Name="TokenBox" Width="110" VerticalContentAlignment="Center"/>
            <Button x:Name="ConnectBtn" Content="连接" Click="ConnectBtn_Click" Margin="8,0,0,0" Padding="12,3"/>
            <Button x:Name="DisconnectBtn" Content="断开" Click="DisconnectBtn_Click" Margin="8,0,0,0" Padding="12,3" IsEnabled="False"/>
            <TextBlock x:Name="StatusText" Text="未连接" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="8,0,8,8" BorderBrush="#444" BorderThickness="1">
            <Image x:Name="ScreenImage"
                   Focusable="True"
                   Stretch="Uniform"
                   MouseMove="ScreenImage_MouseMove"
                   MouseDown="ScreenImage_MouseButton"
                   MouseUp="ScreenImage_MouseButton"
                   MouseWheel="ScreenImage_MouseWheel"/>
        </Border>
    </Grid>
</Window>
